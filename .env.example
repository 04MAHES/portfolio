# --- Frontend (public, bundled into the client) ---
# Endpoint the contact form posts to. Defaults to the bundled serverless
# function at /api/contact. Override only if you use a third-party form
# service instead (e.g. https://formspree.io/f/<form-id>).
VITE_CONTACT_FORM_ENDPOINT=/api/contact

# --- Server only (NEVER prefixed with VITE_, never sent to the browser) ---
# Used by api/contact.ts to deliver messages by email.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Destination inbox for contact-form messages.
CONTACT_TO_EMAIL=sumamaheswarraju@gmail.com
# Verified sender domain in Resend. Leave as onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
